{
  "name": "skytrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "go run ./server",
    "start": "go run ./server",
    "agent": "go run ./receiver/agent",
    "build": "npm --prefix web run build",
    "test:go": "go test ./... && go vet ./...",
    "test": "node --test --test-timeout=10000 tests/**/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-timeout=10000 --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 --test-coverage-include=web/src/settings.js --test-coverage-include=web/src/aircraft-view.js --test-coverage-include=web/src/map-view.js tests/**/*.test.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "check": "npm run test:go && npm run test:coverage && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
